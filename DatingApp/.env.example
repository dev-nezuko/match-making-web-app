# HMAC-SHA512 key that signs every JWT the API issues. At least 64 characters.
# Generate one with:  openssl rand -base64 48
APP_TOKEN_KEY=

# Optional Cloudinary account for photo uploads. Leave empty to run without
# uploads; everything else works.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
